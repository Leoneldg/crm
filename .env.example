# Copia este archivo como .env y cambia los valores.

# Contraseña del usuario "crm" de Postgres (la usa docker-compose para
# crear la base y para armar DATABASE_URL). Que sea larga.
POSTGRES_PASSWORD=cambia-esta-clave

# Firma de las sesiones. Genera una con:
#   openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-al-azar

# Puerto del servidor donde queda escuchando el CRM.
CRM_PORT=3100

# Sólo para correrlo en tu computadora sin Docker (npm run dev):
# DATABASE_URL=postgresql://crm:cambia-esta-clave@localhost:5432/crm
